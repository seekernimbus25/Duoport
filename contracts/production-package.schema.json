{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://studio.example/contracts/production-package-2.0.0.json",
  "title": "studio-production-package 2.0.0",
  "type": "object",
  "required": ["schema", "version", "exportedAt", "project", "scenes", "shots", "takes", "media", "mediaRelink", "narrativeOrder", "editOrder", "shootDays", "setups", "continuity", "omissions", "readiness", "contents", "wrapReport"],
  "properties": {
    "schema": { "const": "studio-production-package" },
    "version": { "type": "string", "pattern": "^2\\.\\d+\\.\\d+$" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "project": { "type": "object", "required": ["id", "name", "aspectRatio"], "properties": { "id": { "$ref": "#/definitions/id" }, "name": { "type": "string" } } },
    "brief": { "$ref": "#/definitions/approvedText" },
    "finalScript": { "$ref": "#/definitions/approvedText" },
    "finalVoiceover": { "$ref": "#/definitions/approvedText" },
    "scenes": { "type": "array", "items": { "type": "object", "required": ["id", "projectId", "number", "title"], "properties": { "id": { "$ref": "#/definitions/id" } } } },
    "shots": { "type": "array", "items": { "type": "object", "required": ["id", "code", "projectId", "sceneId", "storyOrder", "shootOrder", "title", "status", "camera", "editorial", "takeIds", "preferredTakeId"],
      "properties": { "id": { "$ref": "#/definitions/id" }, "status": { "enum": ["planned", "ready", "in progress", "complete", "skipped", "missing"] }, "takeIds": { "type": "array", "items": { "$ref": "#/definitions/id" } }, "preferredTakeId": { "type": ["string", "null"] } } } },
    "takes": { "type": "array", "items": { "type": "object", "required": ["id", "projectId", "shotId", "number", "mediaAssetIds", "capturedAt", "preferred", "quality"],
      "properties": { "quality": { "enum": ["usable", "unusable", "review"] }, "kind": { "enum": ["picture", "audio", "roomTone", "reference"] }, "rating": { "type": "number", "minimum": 1, "maximum": 5 } } } },
    "media": { "type": "array", "items": { "type": "object", "required": ["id", "projectId", "filename", "uri", "role", "mime", "placeholder"], "properties": { "role": { "enum": ["master", "derivative"] } } } },
    "mediaRelink": { "type": "array", "items": { "type": "object",
      "required": ["mediaId", "role", "masterId", "filename", "originalFilename", "deviceUri", "uriKind", "portablePath", "mime", "verification"],
      "properties": { "role": { "enum": ["master", "derivative"] }, "uriKind": { "enum": ["android-content", "android-file", "simulated", "remote", "unknown"] }, "portablePath": { "type": "null" },
        "verification": { "enum": ["simulated", "reported", "verified", "missing", "invalid"] },
        "checksum": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["algo", "value"], "properties": { "algo": { "enum": ["sha256", "fast-sha256"] }, "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }] } } } },
    "narrativeOrder": { "type": "array", "items": { "$ref": "#/definitions/id" } },
    "editOrder": { "type": "array", "items": { "$ref": "#/definitions/id" } },
    "shootOrder": { "type": "array", "items": { "$ref": "#/definitions/id" } },
    "shootDays": { "type": "array", "items": { "type": "object", "required": ["id", "projectId", "date", "order", "history"], "properties": { "order": { "type": "array", "items": { "$ref": "#/definitions/id" } } } } },
    "setups": { "type": "array", "items": { "type": "object", "required": ["id", "projectId", "name", "shotIds", "version"] } },
    "continuity": { "type": "array", "items": { "type": "object", "required": ["id", "shotId", "aspect", "basis", "history"], "properties": { "basis": { "enum": ["record", "speculative"] } } } },
    "omissions": { "type": "array", "items": { "type": "object", "required": ["id", "what", "reason"] } },
    "storyboardIndex": { "type": "array", "items": { "type": "object", "required": ["id", "shotId", "version", "chosen", "conceptual", "file"] } },
    "audioRecords": { "type": "array", "items": { "type": "object", "required": ["takeId", "shotId", "kind"], "properties": { "kind": { "enum": ["audio", "roomTone"] } } } },
    "readiness": { "type": "object", "required": ["preProductionComplete", "productionRecordsComplete", "actualMediaVerified", "readyForEditorialHandoff"],
      "additionalProperties": { "type": "object", "required": ["ok", "reasons"], "properties": { "ok": { "type": "boolean" }, "reasons": { "type": "array", "items": { "type": "string" } } } } },
    "contents": { "type": "object", "required": ["footageIncluded"], "properties": { "footageIncluded": { "const": false } } },
    "wrapReport": { "type": "object", "required": ["plannedVsActual", "mediaInventory", "bestTakes", "omissions", "unresolved", "readyForEdit"] }
  },
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "approvedText": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["artifactId", "versionId", "text"] }] }
  }
}
