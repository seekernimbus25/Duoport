<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            
            <solid android:color="@color/glass_selected" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            
            <solid android:color="#40FFFFFF" />
            <stroke android:width="1dp" android:color="@color/glass_edge" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    
                    <solid android:color="@color/glass_fill" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    
                    <gradient android:angle="270" android:startColor="@color/glass_sheen_top" android:endColor="@color/glass_sheen_bottom" />
                    <stroke android:width="1dp" android:color="@color/glass_edge" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
