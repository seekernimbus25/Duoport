<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DualFrame" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/ink_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="bottomSheetDialogTheme">@style/DualFrame.SheetDialog</item>
        <item name="materialAlertDialogTheme">@style/DualFrame.AlertDialog</item>
    </style>

    <!-- Settings sheet: frosted glass over a blurred camera (blur is added in code on Android 12+). -->
    <style name="DualFrame.SheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/DualFrame.Sheet</item>
        <item name="android:backgroundDimAmount">0.25</item>
    </style>

    <style name="DualFrame.Sheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/glass_fill_strong</item>
        <item name="shapeAppearance">@style/DualFrame.SheetShape</item>
    </style>

    <style name="DualFrame.SheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
    </style>

    <style name="DualFrame.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/ink_raised</item>
        <item name="colorPrimary">@color/accent</item>
    </style>

    <!-- Type: light, airy display numbers; small tracked capitals for labels. -->
    <style name="DF.Text.Label" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="DF.Text.Value" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="DF.Text.Mode" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="DF.Text.Title" parent="">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="DF.Text.Section" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="DF.Text.Body" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="DF.Text.Caption" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="DF.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Round glass icon button. -->
    <style name="DF.IconButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_glass_circle</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/text_primary</item>
    </style>

    <!-- Primary action: solid warm white pill with ink text. -->
    <style name="DF.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/text_primary</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="cornerRadius">26dp</item>
    </style>

    <!-- Secondary action: glass pill with a hairline edge. -->
    <style name="DF.Button.Glass" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/glass_edge</item>
        <item name="backgroundTint">@color/glass_fill</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">24dp</item>
        <item name="iconTint">@color/text_primary</item>
    </style>
</resources>
