<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <com.dualframe.camera.FrameOverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Live second camera in Front + Back, placed by MainActivity exactly where the inset goes. -->
    <FrameLayout
        android:id="@+id/inset_frame"
        android:layout_width="90dp"
        android:layout_height="120dp"
        android:background="@color/text_primary"
        android:padding="1.5dp"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/inset_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />
    </FrameLayout>

    <!-- Above the top bar (translationZ): with eye contact it sits up by the lens, under the
         top buttons, and they took its touches, so its handle couldn't be dragged. No shadow. -->
    <com.dualframe.camera.TeleprompterView
        android:id="@+id/teleprompter"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="top"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="190dp"
        android:outlineProvider="none"
        android:translationZ="2dp"
        android:visibility="gone" />

    <!-- ───────────── Top ───────────── -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:orientation="vertical"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/script_button"
                style="@style/DF.IconButton"
                android:layout_gravity="center_vertical|start"
                android:contentDescription="@string/teleprompter"
                android:src="@drawable/ic_article"
                android:tint="@color/icon_tint" />

            <ImageButton
                android:id="@+id/dual_button"
                style="@style/DF.IconButton"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="58dp"
                android:contentDescription="@string/front_and_back"
                android:src="@drawable/ic_picture_in_picture_alt"
                android:tint="@color/icon_tint" />

            <ImageButton
                android:id="@+id/night_button"
                style="@style/DF.IconButton"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="116dp"
                android:contentDescription="@string/night"
                android:src="@drawable/ic_bedtime"
                android:tint="@color/icon_tint" />

            <ImageButton
                android:id="@+id/torch_button"
                style="@style/DF.IconButton"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="116dp"
                android:contentDescription="@string/torch"
                android:src="@drawable/ic_flashlight_off"
                android:tint="@color/icon_tint" />

            <ImageButton
                android:id="@+id/timer_button"
                style="@style/DF.IconButton"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="58dp"
                android:contentDescription="@string/self_timer"
                android:src="@drawable/ic_timer_off"
                android:tint="@color/icon_tint" />

            <ImageButton
                android:id="@+id/settings_button"
                style="@style/DF.IconButton"
                android:layout_gravity="center_vertical|end"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_tune" />
        </FrameLayout>

        <!-- Shown while recording, in place of the format pills. -->
        <LinearLayout
            android:id="@+id/timer_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_timer"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/timer"
                style="@style/DF.Text.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- The videos being made. Tap one to move its frame. -->
        <HorizontalScrollView
            android:id="@+id/format_scroller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/format_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp" />
        </HorizontalScrollView>

        <!-- Pro only: what the camera is doing, tap any value to take control. -->
        <HorizontalScrollView
            android:id="@+id/pro_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/readouts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp" />
        </HorizontalScrollView>

        <!-- Pro: histogram and how far exposure is from a balanced picture. -->
        <LinearLayout
            android:id="@+id/monitor_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/exposure_meter"
                style="@style/DF.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:shadowColor="#99000000"
                android:shadowRadius="4"
                android:textColor="@color/text_primary" />

            <com.dualframe.camera.HistogramView
                android:id="@+id/histogram"
                android:layout_width="112dp"
                android:layout_height="52dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ae_lock_pill"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_pill"
            android:drawablePadding="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.14"
            android:paddingHorizontal="14dp"
            android:text="@string/ae_af_lock"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/meter_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                style="@style/DF.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/audio_level" />

            <com.dualframe.camera.AudioMeterView
                android:id="@+id/audio_meter"
                android:layout_width="120dp"
                android:layout_height="6dp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/info"
            style="@style/DF.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:shadowColor="#99000000"
            android:shadowRadius="4" />
    </LinearLayout>

    <!-- ───────────── Bottom ───────────── -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/control_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_glass_panel"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hint"
            style="@style/DF.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:text="@string/hint_frames"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/corner_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                style="@style/DF.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/second_camera_corner" />

            <LinearLayout
                android:id="@+id/corner_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/zoom_capsule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp" />

        <TextView
            android:id="@+id/zoom_label"
            style="@style/DF.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp" />

        <!-- VIDEO · PHOTO  |  AUTO · PRO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/capture_video"
                style="@style/DF.Text.Mode"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/capture_video" />

            <TextView
                android:id="@+id/capture_photo"
                style="@style/DF.Text.Mode"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/capture_photo" />

            <TextView
                android:id="@+id/capture_shots"
                style="@style/DF.Text.Mode"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/capture_shots" />

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:background="@color/glass_edge" />

            <LinearLayout
                android:id="@+id/mode_auto"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/mode_auto_text"
                    style="@style/DF.Text.Mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_auto" />

                <View
                    android:id="@+id/mode_auto_dot"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_mode_dot" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mode_pro"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/mode_pro_text"
                    style="@style/DF.Text.Mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_pro" />

                <View
                    android:id="@+id/mode_pro_dot"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_mode_dot" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:paddingHorizontal="36dp">

            <!-- Latest video; opens the library. -->
            <FrameLayout
                android:id="@+id/gallery_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/library"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/gallery_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/ic_photo_library"
                    app:tint="@color/text_primary" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/gallery_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="1dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/DF.Circle"
                    app:strokeColor="@color/glass_edge"
                    app:strokeWidth="1dp" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/record_button"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:background="@null"
                android:contentDescription="@string/start_recording"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_record" />

            <ImageButton
                android:id="@+id/flip_button"
                style="@style/DF.IconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|end"
                android:contentDescription="@string/flip_camera"
                android:src="@drawable/ic_cameraswitch" />

            <!-- Takes the flip button's place while recording. -->
            <ImageButton
                android:id="@+id/pause_button"
                style="@style/DF.IconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|end"
                android:contentDescription="@string/pause_recording"
                android:src="@drawable/ic_pause"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Self-timer countdown. -->
    <TextView
        android:id="@+id/countdown"
        android:translationZ="4dp"
        style="@style/DF.Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:shadowColor="#99000000"
        android:shadowRadius="12"
        android:textSize="120sp"
        android:visibility="gone" />

    <!-- ───────────── Overlays ───────────── -->
    <LinearLayout
        android:id="@+id/permission_panel"
        android:translationZ="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="40dp"
        android:visibility="gone">

        <TextView
            style="@style/DF.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/permission_title" />

        <TextView
            style="@style/DF.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/permission_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grant_button"
            style="@style/DF.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingHorizontal="32dp"
            android:text="@string/permission_button" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/export_panel"
        android:translationZ="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="40dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/export_step"
            style="@style/DF.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/export_title"
            style="@style/DF.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/export_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:max="100"
            app:indicatorColor="@color/accent"
            app:trackColor="#1FFFFFFF"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp" />

        <TextView
            android:id="@+id/export_percent"
            style="@style/DF.Text.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            style="@style/DF.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/exporting_note" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/result_panel"
        android:translationZ="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:fillViewport="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/DF.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_eyebrow" />

            <TextView
                style="@style/DF.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/result_title" />

            <TextView
                style="@style/DF.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/result_subtitle" />

            <LinearLayout
                android:id="@+id/result_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/record_again"
                style="@style/DF.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/record_again" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_library"
                style="@style/DF.Button.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/open_library" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
